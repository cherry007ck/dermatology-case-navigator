# Copy to services/api/.env (gitignored). Never commit real values.
APP_ENV=development
# memory = development storage (UI shows "Development storage — not Exasol").
# exasol = live storage; needs the four EXASOL_* values and a stable SESSION_TOKEN_SECRET. No memory fallback.
DATA_BACKEND=memory
# host:port from Exasol SaaS "Connect via tools" (not secret, but keep it out of git anyway).
EXASOL_DSN=
EXASOL_USER=
# SaaS personal access token. Secret. PyExasol 4.0.0 accepts it as the password.
EXASOL_PASSWORD=
EXASOL_SCHEMA=DERMA_NAV
# PyExasol sends a usage event on connect unless this is set; the API sets it to 1 by default.
EXASOL_TELEMETRY_DISABLE=1
CORS_ORIGINS=http://localhost:3000
# Blank in development/test accepts the documented local code "local-demo". Set a real value elsewhere.
DEMO_ACCESS_CODE=
# Long random value from a password manager; keep stable across restarts.
SESSION_TOKEN_SECRET=
VOICE_TOOL_SECRET=
# fixture = deterministic keyword rules ("Demo extraction"; tests/CI). meta = Meta Model API candidate extraction.
# Both feed the same server validation and structured-v1 ranking. Meta mode never falls back to fixture.
EXTRACTOR_MODE=fixture
# Meta Model API (OpenAI-compatible Responses endpoint). https only; requests go only to this base URL.
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3-contributor
# Meta Model API key. Secret, server-only. Check access with: python -m scripts.check_model
MODEL_API_KEY=
COLLECTION_MODE=synthetic
