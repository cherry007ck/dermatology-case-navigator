# Copy to apps/web/.env.local (gitignored). Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle: URLs and modes only, never secrets.

# mock = shared fixture responses, no backend (labelled in the UI). live = call the FastAPI backend.
# Voice needs live: the backend issues the scoped voice binding.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Server-only (read by app/api/voice-session; never sent to the browser) ----
# FastAPI base URL the Next.js server uses to verify the session and get a voice binding.
API_INTERNAL_BASE_URL=http://localhost:8000
# ElevenLabs API key (Settings -> API keys). Secret. Leave blank to disable voice.
ELEVENLABS_API_KEY=
# Private agent ID, starts with agent_ (Agent -> settings). Not secret, but keep it server-side.
ELEVENLABS_AGENT_ID=
# Optional comma-separated extra origins allowed to call /api/voice-session (same origin is always allowed).
VOICE_ALLOWED_ORIGINS=
